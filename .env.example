# --- Integrasi cek NIB OSS RBA (API JELITA DPMPTSP via SPLPD Jabar) ---
# disabled = fitur mati (bawaan) | dummy = data uji coba | api = koneksi produksi
OSS_DRIVER=disabled
# false = NIB tidak ditemukan tetap diterima tapi ditandai untuk admin; true = ditolak
OSS_STRICT=false
OSS_CACHE_MINUTES=720
OSS_RATE_PER_MINUTE=10
OSS_TIMEOUT=10
OSS_JELITA_BASE_URL=https://api-splp.layanan.go.id/t/jabarprov.go.id
OSS_JELITA_PATH=/dpmptsp-jelita/1.00/nib/proyek/
# Isi HANYA di .env server. Jangan di-commit.
OSS_JELITA_APIKEY=
OSS_JELITA_TOKEN=
